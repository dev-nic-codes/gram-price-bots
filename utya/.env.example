BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
CHANNEL_USERNAME=@utyaprices
CONTROL_CHAT_ID=123456789
CONTROL_USER_ID=123456789
ALLOWED_CONTROL_USER_IDS=123456789,987654321

POST_INTERVAL_SECONDS=60
DECIMAL_PLACES=6
HTTP_TIMEOUT_SECONDS=20
RETRY_DELAY_SECONDS=15
COMMAND_TIMEOUT_SECONDS=25
USER_AGENT=utya-price-bot/2.0

# Optional. Enables authenticated TONAPI requests for wallet DNS resolution.
TONAPI_TOKEN=

# Optional. Point to a shared Meme Prices cache when both projects are local.
# MEME_PRICE_CACHE_PATH=/path/to/meme-price-bot/output/price_cache.json
