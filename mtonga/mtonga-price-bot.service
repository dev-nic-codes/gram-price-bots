[Unit]
Description=MTONGA Telegram price bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pricebot
Group=pricebot
WorkingDirectory=/opt/gram-price-bots/mtonga
EnvironmentFile=/opt/gram-price-bots/mtonga/.env
ExecStart=/usr/bin/python3 /opt/gram-price-bots/mtonga/main.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gram-price-bots/mtonga

[Install]
WantedBy=multi-user.target
