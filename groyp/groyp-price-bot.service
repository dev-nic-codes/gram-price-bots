[Unit]
Description=GROYP Telegram price bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pricebot
Group=pricebot
WorkingDirectory=/opt/gram-price-bots/groyp
EnvironmentFile=/opt/gram-price-bots/groyp/.env
ExecStart=/usr/bin/python3 /opt/gram-price-bots/groyp/main.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/gram-price-bots/groyp

[Install]
WantedBy=multi-user.target
